{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@engine/*": ["./engine/*"]
    }
  },
  "include": ["engine", "templates/*/src", "templates/*/content", "templates/*/game.config.ts", "games/*/src", "games/*/content", "games/*/game.config.ts", "tests", "vitest.config.ts", "playwright.config.ts"]
}
